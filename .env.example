# Stripe (use sk_test_ / pk_test_ locally; sk_live_ / pk_live_ in Vercel Production)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — never commit real keys; set these in Vercel env for each environment
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local/dev only — never set in Production. Allows checkout without Stripe keys.
# ALLOW_MOCK_PAYMENTS=true

# Optional: HMAC secret for admin-auth-cache cookie (falls back to service role key)
# AUTH_CACHE_SECRET=long-random-string

# Initial super admin. Used only by `npm run bootstrap:super-admin`.
# Never commit a real password. Apply the canonical roles migration first.
SUPER_ADMIN_EMAIL=super@admin.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: Google Maps (Distance Matrix) for delivery route optimization.
# Without this key, /api/delivery/optimize uses a deterministic nearest-neighbor heuristic.
# GOOGLE_MAPS_API_KEY=

# Optional: Sentry error reporting (no-op stub until @sentry/nextjs is installed)
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production


# Whop: planner checkout links, connected accounts, KYC, and commission payouts.
# Never commit real values. Set these in Vercel env per environment.
# WHOP_API_KEY: Whop dashboard → Developer → API keys (company API key).
# WHOP_COMPANY_ID: your company id (biz_...), shown in the dashboard URL or GET /accounts/me.
# WHOP_WEBHOOK_SECRET: Developer → Webhooks → create a webhook pointing at
#   https://<your-domain>/api/webhooks/whop (events: payment.succeeded, refund.created,
#   refund.updated, dispute.created, dispute.updated, transfer.completed, transfer.failed,
#   verification.succeeded). Copy the ws_... signing secret.
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_...
WHOP_WEBHOOK_SECRET=ws_...
# Optional: sandbox testing
# WHOP_API_BASE=https://sandbox-api.whop.com/api/v1
