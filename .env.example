# Stripe (use sk_test_ / pk_test_ locally; sk_live_ / pk_live_ in Vercel Production)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Connect webhook (events on planners' connected accounts) -> /api/stripe/connect-webhook
# Separate endpoint and signing secret from STRIPE_WEBHOOK_SECRET. Events: account.updated,
# checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Planner membership ($99/mo recurring price). Optional: if unset, the app finds or creates
# a price with lookup_key `planner_membership_monthly` on first signup.
STRIPE_PRICE_PLANNER_MEMBERSHIP=price_...
# Used for Stripe redirect URLs (Checkout, Billing portal, payment links).
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase — never commit real keys; set these in Vercel env for each environment
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local/dev only — never set in Production. Allows checkout without Stripe keys.
# ALLOW_MOCK_PAYMENTS=true

# Optional: HMAC secret for admin-auth-cache cookie (falls back to service role key)
# AUTH_CACHE_SECRET=long-random-string

# Initial super admin. Used only by `npm run bootstrap:super-admin`.
# Never commit a real password. Apply the canonical roles migration first.
SUPER_ADMIN_EMAIL=super@admin.com
SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: Google Maps (Distance Matrix) for delivery route optimization.
# Without this key, /api/delivery/optimize uses a deterministic nearest-neighbor heuristic.
# GOOGLE_MAPS_API_KEY=

# Optional: Sentry error reporting (no-op stub until @sentry/nextjs is installed)
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production

