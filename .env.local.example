# Stripe (use sk_test_ / pk_test_ locally; sk_live_ / pk_live_ in Vercel Production)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase — never commit real keys; set these in Vercel env for each environment
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local/dev only — never set in Production. Allows checkout without Stripe keys.
# ALLOW_MOCK_PAYMENTS=true

# Optional: Postgres (scripts / direct SQL)
# POSTGRES_URL=postgres://...
